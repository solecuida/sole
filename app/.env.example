# Sole · variables de entorno. Este archivo SÍ se versiona; nunca lleva valores reales.
# En local, `pnpm -C app env:local` escribe .env.local y .env.test.local con valores locales.
# En producción, cada valor se carga en Vercel → Project → Settings → Environment Variables.
# La lista completa, en el orden del lanzamiento, está en docs/lanzamiento.md.

# Dirección de la app (enlaces mágicos, invitaciones, robots); en producción https://app.solecuida.com, se escribe a mano en Vercel.
APP_URL=http://localhost:3000
# Dirección de la API de Supabase; en producción sale del panel de Supabase → Project Settings → API.
SUPABASE_URL=
# Clave pública de Supabase para el cliente con sesión; en producción sale del panel de Supabase → API Keys.
SUPABASE_PUBLISHABLE_KEY=
# Clave secreta de Supabase (solo servidor); en producción sale del panel de Supabase → API Keys.
SUPABASE_SECRET_KEY=
# Clave que cifra campos sensibles, con forma <versión>:<32 bytes en base64>; la genera el fundador (docs/lanzamiento.md).
FIELD_ENCRYPTION_KEY=
# Clave anterior, solo mientras se rota la vigente; es el valor que tenía FIELD_ENCRYPTION_KEY (docs/mantenimiento.md).
FIELD_ENCRYPTION_KEY_PREVIOUS=
# Secreto de los avisos programados (cabecera x-cron-secret); lo genera el fundador y es el mismo que el del Vault de Supabase.
CRON_SECRET=
# Secreto para anonimizar IP y correos en los límites de frecuencia; lo genera el fundador (docs/lanzamiento.md).
IP_HASH_SECRET=
# Clave pública VAPID de los avisos al teléfono; la genera el fundador junto con la privada (docs/lanzamiento.md).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# Clave privada VAPID de los avisos al teléfono; sale del mismo comando que la pública.
VAPID_PRIVATE_KEY=
# Contacto que se declara al enviar avisos; es el correo de contacto de Sole y no es un secreto.
VAPID_SUBJECT=mailto:hola@solecuida.com
# Clave pública del captcha de la pantalla de ingreso; sale de Cloudflare → Turnstile.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Clave secreta del captcha (formulario de la web); sale de Cloudflare → Turnstile.
TURNSTILE_SECRET_KEY=
# Dirección (DSN) pública del proyecto de errores; sale de Sentry → Project Settings → Client Keys.
NEXT_PUBLIC_SENTRY_DSN=
# Token para subir los mapas de código en el build; sale de Sentry → Settings → Auth Tokens.
SENTRY_AUTH_TOKEN=
# Nombre (slug) de la organización en Sentry; sale de la dirección de Sentry de la organización.
SENTRY_ORG=
# Nombre (slug) del proyecto en Sentry; sale de la dirección del proyecto en Sentry.
SENTRY_PROJECT=
# Clave para enviar los correos de inactividad; sale de Resend → API Keys.
RESEND_API_KEY=
# Remitente de los correos, por ejemplo Sole <avisos@notificaciones.solecuida.com>; se escribe a mano en Vercel.
EMAIL_FROM=
# Dirección del proyecto de Supabase de la web (sole-web); sale de su panel → Project Settings → API.
WEB_CONTACT_SUPABASE_URL=
# Clave secreta del proyecto sole-web; sale de su panel → API Keys y nunca llega al navegador.
WEB_CONTACT_SUPABASE_SECRET_KEY=
# Orígenes de la web que pueden enviar el formulario, separados por comas; en producción https://solecuida.com y https://www.solecuida.com.
WEB_ALLOWED_ORIGINS=
