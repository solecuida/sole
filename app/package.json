{
  "name": "app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:types": "supabase gen types typescript --local --schema public > src/lib/supabase/database.types.ts",
    "env:local": "supabase status -o json | tsx scripts/write-local-env.ts",
    "cron:dispatch": "tsx scripts/trigger-cron.ts dispatch",
    "cron:daily": "tsx scripts/trigger-cron.ts daily"
  },
  "dependencies": {
    "@date-fns/tz": "1.5.0",
    "@hookform/resolvers": "7.0.6",
    "@marsidev/react-turnstile": "1.6.3",
    "@sentry/nextjs": "11.12.0",
    "@serwist/next": "9.5.13",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.119.0",
    "date-fns": "4.4.0",
    "html-to-image": "1.11.13",
    "idb": "8.0.4",
    "lucide-react": "1.72.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.92.0",
    "recharts": "3.10.1",
    "web-push": "3.6.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.6.7",
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "4.3.5",
    "@tailwindcss/turbopack": "4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/web-push": "3.6.4",
    "@vitejs/plugin-react": "6.3.0",
    "jsdom": "31.0.1",
    "serwist": "9.5.13",
    "supabase": "2.122.1",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "~6.0.3",
    "vitest": "5.1.0"
  },
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=22.12.0 <23"
  }
}
